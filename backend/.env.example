# ====================================================================
# Tata Dukaan Saathi – Clean Architecture Core Backend Environment
# Tata Imagination Cup 2026
# Copy this file to .env and configure for development or production.
# NOTE: Never commit .env or API keys to version control.
# ====================================================================

# Runtime
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# Primary Database (PostgreSQL 16)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tata_dukaan_saathi_db
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20
DATABASE_READ_REPLICA_URL=postgresql://postgres:postgres@localhost:5433/tata_dukaan_saathi_replica

# Caching & Distributed Synchronization (Redis 7)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_CACHE_DEFAULT_TTL=3600

# Event Streaming (Apache Kafka / Embedded Bus)
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=tata-saathi-backend
KAFKA_GROUP_ID=tata-saathi-core-group

# Authentication & JWT
JWT_SECRET=tata-dukaan-saathi-enterprise-jwt-secret-min32chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=tata-dukaan-saathi-refresh-secret-key-min32
JWT_REFRESH_EXPIRES_IN=7d

# Groq LPU (Indic LLM Reasoning & SKU Mapping)
GROQ_API_KEY=your_groq_api_key_here

# Telephony & Messaging Integration (Twilio WhatsApp & Voice)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
TWILIO_VOICE_NUMBER=+12025550143

# Tata Ecosystem Adapter Configuration
TATA_CONSUMER_DISTRIBUTOR_ENDPOINT=https://distributor-api.tataconsumer.com/v1
TATA_CAPITAL_LOS_ENDPOINT=https://api.tatacapital.com/lending/v1
TATA_PAY_GATEWAY_ENDPOINT=https://merchant-pay.tatadigital.com/v1

# Storage (S3 / MinIO / Local)
STORAGE_PROVIDER=local
STORAGE_BUCKET=tata-saathi-assets
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Local Zero-Dependency Execution (Embedded storage & event bus)
USE_IN_MEMORY_DB=true
USE_EMBEDDED_BUS=true
