# ====================================================================
# Tata Dukaan Saathi - Git Ignore Configuration
# Strict Security Guardrails: Never Commit Sensitive Credentials or Keys
# ====================================================================

# Environment and Secret Files (Strictly Ignored)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
backend/.env.*
backend/.env.local
*.pem
*.key
*.cert
*.crt
credentials.json
secrets.json
service-account*.json

# Allow only explicit documentation examples
!.env.example
!backend/.env.example

# Dependencies
node_modules/
backend/node_modules/
*/node_modules/
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# Build and Compilation Outputs
.next/
out/
build/
dist/
backend/dist/
*/dist/
*.tsbuildinfo
next-env.d.ts
.turbo/

# Testing & Coverage
coverage/
.nyc_output/
*.lcov

# Logs and Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python & ML Artifacts
__pycache__/
*/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
.venv/

# OS and Editor Specific
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Temporary Storage & Local Uploads
backend/uploads/*
!backend/uploads/.gitkeep
tmp/
temp/
