# ====================================================================
# Tata Dukaan Saathi - Environment Configuration Template
# Tata Imagination Cup 2026
# Copy this file to .env and fill in your actual credentials.
# NOTE: Never commit .env or API keys to version control.
# ====================================================================

# Groq LPU Cloud (Used for fast Indic LLM reasoning & SKU parsing)
GROQ_API_KEY=your_groq_api_key_here

# Telephony & Messaging Integration (Twilio WhatsApp & Voice)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
TWILIO_VOICE_NUMBER=+12025550143

# Backend Core API
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000

# Tata Ecosystem Integration Modes (Adapters)
TATA_CONSUMER_ADAPTER_MODE=simulated
TATA_CAPITAL_ADAPTER_MODE=simulated
TATA_PAY_ADAPTER_MODE=simulated
TCS_CLOUD_REGION=ap-south-1
